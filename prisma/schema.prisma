generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model crm_Accounts {
  id                   String                @id @default(uuid()) @db.Uuid
  v                    Int                   @map("__v")
  createdAt            DateTime              @default(now())
  createdBy            String?               @db.Uuid
  updatedAt            DateTime?             @updatedAt
  updatedBy            String?               @db.Uuid
  annual_revenue       String?
  assigned_to          String?               @db.Uuid
  billing_city         String?
  billing_country      String?
  billing_postal_code  String?
  billing_state        String?
  billing_street       String?
  company_id           String?
  description          String?
  email                String?
  employees            String?
  fax                  String?
  industry             String?               @db.Uuid
  member_of            String?
  name                 String
  office_phone         String?
  shipping_city        String?
  shipping_country     String?
  shipping_postal_code String?
  shipping_state       String?
  shipping_street      String?
  status               String?               @default("Inactive")
  type                 String?               @default("Customer")
  vat                  String?
  website              String?
  deletedAt            DateTime?
  deletedBy            String?               @db.Uuid
  documents            DocumentsToAccounts[]
  emails               EmailsToAccounts[]
  accountProducts      crm_AccountProducts[]
  assigned_to_user     Users?                @relation("AccountAssignedTo", fields: [assigned_to], references: [id])
  industry_type        crm_Industry_Type?    @relation(fields: [industry], references: [id])
  crm_accounts_tasks   crm_Accounts_Tasks[]
  contacts             crm_Contacts[]
  leads                crm_Leads[]

  @@index([assigned_to])
  @@index([industry])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
}

model crm_Leads {
  id                String             @id @default(uuid()) @db.Uuid
  v                 Int                @default(0) @map("__v")
  createdAt         DateTime?          @default(now())
  createdBy         String?            @db.Uuid
  updatedAt         DateTime?          @updatedAt
  updatedBy         String?            @db.Uuid
  firstName         String?
  lastName          String
  company           String?
  jobTitle          String?
  email             String?
  phone             String?
  description       String?
  lead_source_id    String?            @db.Uuid
  lead_status_id    String?            @db.Uuid
  lead_type_id      String?            @db.Uuid
  refered_by        String?
  assigned_to       String?            @db.Uuid
  accountsIDs       String?            @db.Uuid
  deletedAt         DateTime?
  deletedBy         String?            @db.Uuid
  documents         DocumentsToLeads[]
  assigned_accounts crm_Accounts?      @relation(fields: [accountsIDs], references: [id])
  assigned_to_user  Users?             @relation("LeadAssignedTo", fields: [assigned_to], references: [id])
  lead_source       crm_Lead_Sources?  @relation("lead_source_relation", fields: [lead_source_id], references: [id])
  lead_status       crm_Lead_Statuses? @relation("lead_status_relation", fields: [lead_status_id], references: [id])
  lead_type         crm_Lead_Types?    @relation("lead_type_relation", fields: [lead_type_id], references: [id])

  @@index([assigned_to])
  @@index([accountsIDs])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([lead_source_id])
  @@index([lead_status_id])
  @@index([lead_type_id])
  @@index([createdAt])
  @@index([deletedAt])
}

model crm_Contact_Types {
  id       String         @id @default(uuid()) @db.Uuid
  v        Int            @default(0) @map("__v")
  name     String         @unique
  contacts crm_Contacts[]

  @@index([name])
}

model crm_Lead_Sources {
  id    String      @id @default(uuid()) @db.Uuid
  v     Int         @default(0) @map("__v")
  name  String      @unique
  leads crm_Leads[] @relation("lead_source_relation")

  @@index([name])
}

model crm_Lead_Statuses {
  id    String      @id @default(uuid()) @db.Uuid
  v     Int         @default(0) @map("__v")
  name  String      @unique
  leads crm_Leads[] @relation("lead_status_relation")

  @@index([name])
}

model crm_Lead_Types {
  id    String      @id @default(uuid()) @db.Uuid
  v     Int         @default(0) @map("__v")
  name  String      @unique
  leads crm_Leads[] @relation("lead_type_relation")

  @@index([name])
}

model crm_Contacts {
  id                String                @id @default(uuid()) @db.Uuid
  v                 Int                   @default(0) @map("__v")
  account           String?               @db.Uuid
  assigned_to       String?               @db.Uuid
  birthday          String?
  createdBy         String?               @db.Uuid
  created_on        DateTime?             @default(now())
  cratedAt          DateTime?             @default(now())
  last_activity     DateTime?             @default(now())
  updatedAt         DateTime?             @updatedAt
  updatedBy         String?               @db.Uuid
  last_activity_by  String?               @db.Uuid
  description       String?
  email             String?
  personal_email    String?
  first_name        String?
  last_name         String
  office_phone      String?
  mobile_phone      String?
  website           String?
  position          String?
  status            Boolean               @default(true)
  social_twitter    String?
  social_facebook   String?
  social_linkedin   String?
  social_skype      String?
  social_instagram  String?
  social_youtube    String?
  social_tiktok     String?
  contact_type_id   String?               @db.Uuid
  tags              String[]
  notes             String[]
  accountsIDs       String?               @db.Uuid
  deletedAt         DateTime?
  deletedBy         String?               @db.Uuid
  documents         DocumentsToContacts[]
  emails            EmailsToContacts[]
  tasks             crm_Accounts_Tasks[]  @relation("ContactTasks")
  appointments      crm_Appointments[]    @relation("PatientAppointments")
  assigned_accounts crm_Accounts?         @relation(fields: [accountsIDs], references: [id])
  assigned_to_user  Users?                @relation("assigned_contacts", fields: [assigned_to], references: [id])
  contact_type      crm_Contact_Types?    @relation(fields: [contact_type_id], references: [id])
  crate_by_user     Users?                @relation("created_contacts", fields: [createdBy], references: [id])

  @@index([assigned_to])
  @@index([accountsIDs])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([status])
  @@index([contact_type_id])
  @@index([cratedAt])
  @@index([last_activity])
  @@index([deletedAt])
}

model crm_SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model crm_Activities {
  id              String              @id @default(uuid()) @db.Uuid
  type            crm_Activity_Type
  title           String
  description     String?
  date            DateTime
  duration        Int?
  outcome         String?
  status          crm_Activity_Status @default(scheduled)
  metadata        Json?
  createdBy       String?             @db.Uuid
  updatedBy       String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime?           @updatedAt
  deletedAt       DateTime?
  deletedBy       String?             @db.Uuid
  created_by_user Users?              @relation("activity_created_by", fields: [createdBy], references: [id])
  updated_by_user Users?              @relation("activity_updated_by", fields: [updatedBy], references: [id])
  links           crm_ActivityLinks[]

  @@index([date])
  @@index([type])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
  @@index([deletedAt])
}

model crm_ActivityLinks {
  id         String         @id @default(uuid()) @db.Uuid
  activityId String         @db.Uuid
  entityType String
  entityId   String         @db.Uuid
  activity   crm_Activities @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([entityType, entityId, activityId])
}

model Employees {
  id     String  @id @default(uuid()) @db.Uuid
  v      Int     @map("__v")
  avatar String
  email  String?
  name   String
  salary BigInt
  status String
}

model ImageUpload {
  id String @id @default(uuid()) @db.Uuid
}

model Documents {
  id                     String                        @id @default(uuid()) @db.Uuid
  v                      Int?                          @map("__v")
  date_created           DateTime?                     @default(now())
  createdAt              DateTime?                     @default(now())
  last_updated           DateTime?                     @updatedAt
  updatedAt              DateTime?                     @updatedAt
  document_name          String
  created_by_user        String?                       @db.Uuid
  createdBy              String?                       @db.Uuid
  description            String?
  document_type          String?                       @db.Uuid
  favourite              Boolean?
  document_file_mimeType String
  document_file_url      String
  status                 String?
  visibility             String?
  tags                   Json?
  key                    String?
  size                   Int?
  assigned_user          String?                       @db.Uuid
  connected_documents    String[]
  content_text           String?
  summary                String?
  content_hash           String?
  thumbnail_url          String?
  processing_status      DocumentProcessingStatus      @default(PENDING)
  processing_error       String?
  version                Int                           @default(1)
  parent_document_id     String?                       @db.Uuid
  deletedAt              DateTime?
  deletedBy              String?                       @db.Uuid
  document_system_type   DocumentSystemType?           @default(OTHER)
  assigned_to_user       Users?                        @relation("assigned_to_user", fields: [assigned_user], references: [id])
  created_by             Users?                        @relation("created_by_user", fields: [created_by_user], references: [id])
  documents_type         Documents_Types?              @relation(fields: [document_type], references: [id])
  parent_document        Documents?                    @relation("DocumentVersions", fields: [parent_document_id], references: [id])
  child_versions         Documents[]                   @relation("DocumentVersions")
  accounts               DocumentsToAccounts[]
  contacts               DocumentsToContacts[]
  crm_accounts_tasks     DocumentsToCrmAccountsTasks[]
  leads                  DocumentsToLeads[]
  opportunities          DocumentsToOpportunities[]
  tasks                  DocumentsToTasks[]
  chunks                 crm_Document_Chunks[]

  @@index([created_by_user])
  @@index([assigned_user])
  @@index([document_type])
  @@index([createdBy])
  @@index([status])
  @@index([visibility])
  @@index([favourite])
  @@index([createdAt])
  @@index([document_system_type])
  @@index([content_hash])
  @@index([parent_document_id])
  @@index([processing_status])
  @@index([deletedAt])
}

model Documents_Types {
  id                 String      @id @default(uuid()) @db.Uuid
  v                  Int         @map("__v")
  name               String
  assigned_documents Documents[]
}

model crm_Industry_Type {
  id       String         @id @default(uuid()) @db.Uuid
  v        Int            @default(0) @map("__v")
  name     String
  accounts crm_Accounts[]
}

model Tasks {
  id            String             @id @default(uuid()) @db.Uuid
  v             Int                @map("__v")
  content       String?
  createdAt     DateTime?          @default(now())
  createdBy     String?            @db.Uuid
  updatedAt     DateTime?          @updatedAt
  updatedBy     String?            @db.Uuid
  dueDateAt     DateTime?          @default(now())
  lastEditedAt  DateTime?          @default(now()) @updatedAt
  position      BigInt
  priority      String
  tags          Json?
  title         String
  likes         BigInt?            @default(0)
  user          String?            @db.Uuid
  taskStatus    taskStatus?        @default(ACTIVE)
  documents     DocumentsToTasks[]
  assigned_user Users?             @relation(fields: [user], references: [id])
  comments      tasksComments[]

  @@index([user])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([priority])
  @@index([taskStatus])
  @@index([dueDateAt])
  @@index([createdAt])
  @@index([user, taskStatus])
}

model crm_Accounts_Tasks {
  id            String                        @id @default(uuid()) @db.Uuid
  v             Int                           @map("__v")
  content       String?
  createdAt     DateTime?                     @default(now())
  createdBy     String?                       @db.Uuid
  updatedAt     DateTime?                     @updatedAt
  updatedBy     String?                       @db.Uuid
  dueDateAt     DateTime?                     @default(now())
  priority      String
  tags          Json?
  title         String
  likes         BigInt?                       @default(0)
  user          String?                       @db.Uuid
  taskStatus    taskStatus?                   @default(ACTIVE)
  account       String?                       @db.Uuid
  contact       String?                       @db.Uuid
  documents     DocumentsToCrmAccountsTasks[]
  crm_accounts  crm_Accounts?                 @relation(fields: [account], references: [id])
  crm_contact   crm_Contacts?                 @relation("ContactTasks", fields: [contact], references: [id])
  assigned_user Users?                        @relation(fields: [user], references: [id])
  comments      tasksComments[]

  @@index([user])
  @@index([account])
  @@index([contact])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([priority])
  @@index([taskStatus])
  @@index([dueDateAt])
  @@index([createdAt])
  @@index([account, taskStatus])
}

model tasksComments {
  id                             String              @id @default(uuid()) @db.Uuid
  v                              Int                 @map("__v")
  comment                        String
  createdAt                      DateTime            @default(now())
  task                           String?             @db.Uuid
  user                           String              @db.Uuid
  assigned_crm_account_task      String?             @db.Uuid
  assigned_crm_account_task_task crm_Accounts_Tasks? @relation(fields: [assigned_crm_account_task], references: [id])
  assigned_task                  Tasks?              @relation(fields: [task], references: [id], onDelete: Cascade)
  assigned_user                  Users               @relation(fields: [user], references: [id])

  @@index([task])
  @@index([user])
  @@index([assigned_crm_account_task])
}

model TodoList {
  id          String @id @default(uuid()) @db.Uuid
  createdAt   String
  description String
  title       String
  url         String
  user        String
}

model Users {
  id                   String                @id @default(uuid()) @db.Uuid
  v                    Int                   @default(0) @map("__v")
  account_name         String?
  avatar               String?
  email                String                @unique
  emailVerified        Boolean               @default(false)
  image                String?
  role                 AppRole               @default(user)
  created_on           DateTime              @default(now())
  updated_at           DateTime?             @updatedAt
  lastLoginAt          DateTime?
  name                 String?
  password             String?
  username             String?
  userStatus           ActiveStatus          @default(PENDING)
  userLanguage         Language              @default(en)
  banned               Boolean               @default(false)
  banReason            String?
  banExpires           DateTime?
  created_by_id        String?               @db.Uuid
  created_by           Users?                @relation("UserCreator", fields: [created_by_id], references: [id])
  created_users        Users[]               @relation("UserCreator")
  assigned_documents   Documents[]           @relation("assigned_to_user")
  created_by_documents Documents[]           @relation("created_by_user")
  emails               Email[]
  emailAccounts        EmailAccount[]
  tasks                Tasks[]
  authAccounts         Account[]
  accounts             crm_Accounts[]        @relation("AccountAssignedTo")
  crm_accounts_tasks   crm_Accounts_Tasks[]
  activities_created   crm_Activities[]      @relation("activity_created_by")
  activities_updated   crm_Activities[]      @relation("activity_updated_by")
  doctor_appointments  crm_Appointments[]    @relation("DoctorAppointments")
  staff_appointments   crm_Appointments[]    @relation("StaffAppointments")
  auditLogs            crm_AuditLog[]
  assigned_contacts    crm_Contacts[]        @relation("assigned_contacts")
  crated_contacts      crm_Contacts[]        @relation("created_contacts")
  leads                crm_Leads[]           @relation("LeadAssignedTo")
  created_products     crm_Products[]        @relation("ProductCreatedBy")
  report_configs       crm_Report_Config[]   @relation("report_configs")
  report_schedules     crm_Report_Schedule[] @relation("report_schedules")
  sessions             Session[]
  tasksComment         tasksComments[]

  @@index([email])
  @@index([userStatus])
  @@index([userLanguage])
  @@index([role])
  @@index([created_on])
  @@index([lastLoginAt])
}

model crm_AuditLog {
  id         String              @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String              @db.Uuid
  action     crm_AuditLog_Action
  changes    Json?
  userId     String?             @db.Uuid
  createdAt  DateTime            @default(now())
  user       Users?              @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, createdAt])
}

model crm_Report_Config {
  id        String                @id @default(cuid())
  name      String
  category  String
  filters   Json
  isShared  Boolean               @default(false)
  createdBy String                @db.Uuid
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      Users                 @relation("report_configs", fields: [createdBy], references: [id])
  schedules crm_Report_Schedule[]

  @@index([createdBy])
  @@index([category])
  @@index([isShared])
}

model crm_Report_Schedule {
  id             String            @id @default(cuid())
  reportConfigId String
  cronExpression String
  recipients     Json
  format         String
  isActive       Boolean           @default(true)
  lastSentAt     DateTime?
  createdBy      String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           Users             @relation("report_schedules", fields: [createdBy], references: [id])
  reportConfig   crm_Report_Config @relation(fields: [reportConfigId], references: [id], onDelete: Cascade)

  @@index([reportConfigId])
  @@index([createdBy])
  @@index([isActive])
  @@index([lastSentAt])
}

model systemServices {
  id              String  @id @default(uuid()) @db.Uuid
  v               Int     @map("__v")
  name            String
  serviceUrl      String?
  serviceId       String?
  serviceKey      String?
  servicePassword String?
  servicePort     String?
  description     String?
}

model DocumentsToOpportunities {
  document_id    String    @db.Uuid
  opportunity_id String    @db.Uuid
  document       Documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([document_id, opportunity_id])
  @@index([document_id])
  @@index([opportunity_id])
}

model DocumentsToContacts {
  document_id String       @db.Uuid
  contact_id  String       @db.Uuid
  contact     crm_Contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  document    Documents    @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([document_id, contact_id])
  @@index([document_id])
  @@index([contact_id])
}

model DocumentsToTasks {
  document_id String    @db.Uuid
  task_id     String    @db.Uuid
  document    Documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  task        Tasks     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@id([document_id, task_id])
  @@index([document_id])
  @@index([task_id])
}

model DocumentsToCrmAccountsTasks {
  document_id          String             @db.Uuid
  crm_accounts_task_id String             @db.Uuid
  crm_accounts_task    crm_Accounts_Tasks @relation(fields: [crm_accounts_task_id], references: [id], onDelete: Cascade)
  document             Documents          @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([document_id, crm_accounts_task_id])
  @@index([document_id])
  @@index([crm_accounts_task_id])
}

model DocumentsToLeads {
  document_id String    @db.Uuid
  lead_id     String    @db.Uuid
  document    Documents @relation(fields: [document_id], references: [id], onDelete: Cascade)
  lead        crm_Leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@id([document_id, lead_id])
  @@index([document_id])
  @@index([lead_id])
}

model DocumentsToAccounts {
  document_id String       @db.Uuid
  account_id  String       @db.Uuid
  account     crm_Accounts @relation(fields: [account_id], references: [id], onDelete: Cascade)
  document    Documents    @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@id([document_id, account_id])
  @@index([document_id])
  @@index([account_id])
}

model crm_Document_Chunks {
  id          String                @id @default(uuid()) @db.Uuid
  document_id String                @db.Uuid
  chunk_index Int
  chunk_text  String
  embedding   Unsupported("vector")
  embedded_at DateTime              @default(now())
  document    Documents             @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@map("crm_Document_Chunks")
}

model EmailAccount {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  label             String
  imapHost          String
  imapPort          Int
  imapSsl           Boolean   @default(true)
  smtpHost          String
  smtpPort          Int
  smtpSsl           Boolean   @default(true)
  username          String
  passwordEncrypted String
  isActive          Boolean   @default(true)
  sentFolderName    String    @default("Sent")
  lastSyncedAt      DateTime?
  inboxLastUid      Int?
  sentLastUid       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  emails            Email[]
  user              Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Email {
  id             String             @id @default(uuid()) @db.Uuid
  emailAccountId String             @db.Uuid
  userId         String             @db.Uuid
  rfcMessageId   String
  imapUid        Int?
  folder         EmailFolder
  subject        String?
  fromName       String?
  fromEmail      String?
  toRecipients   Json               @default("[]")
  ccRecipients   Json               @default("[]")
  bccRecipients  Json               @default("[]")
  bodyText       String?
  bodyHtml       String?
  sentAt         DateTime?
  isRead         Boolean            @default(false)
  isDeleted      Boolean            @default(false)
  updatedAt      DateTime           @updatedAt
  createdAt      DateTime           @default(now())
  account        EmailAccount       @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  user           Users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       EmailsToAccounts[]
  contacts       EmailsToContacts[]

  @@unique([emailAccountId, rfcMessageId])
  @@index([userId])
  @@index([emailAccountId])
  @@index([folder])
  @@index([isDeleted])
  @@index([sentAt])
  @@index([userId, folder, isDeleted, isRead])
}

model EmailsToContacts {
  emailId   String       @db.Uuid
  contactId String       @db.Uuid
  contact   crm_Contacts @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email     Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([emailId, contactId])
  @@index([emailId])
  @@index([contactId])
}

model EmailsToAccounts {
  emailId   String       @db.Uuid
  accountId String       @db.Uuid
  account   crm_Accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([emailId, accountId])
  @@index([emailId])
  @@index([accountId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model crm_ProductCategories {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String         @db.Uuid
  updatedBy   String?        @db.Uuid
  products    crm_Products[]

  @@index([isActive])
}

model crm_Products {
  id                   String                     @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  sku                  String?                    @unique
  type                 crm_Product_Type
  status               crm_Product_Status         @default(DRAFT)
  unit_price           Decimal                    @db.Decimal(18, 2)
  unit_cost            Decimal?                   @db.Decimal(18, 2)
  tax_rate             Decimal?                   @db.Decimal(5, 2)
  unit                 String?
  is_recurring         Boolean                    @default(false)
  billing_period       crm_Billing_Period?
  categoryId           String?                    @db.Uuid
  v                    Int                        @default(0) @map("__v")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  createdBy            String                     @db.Uuid
  updatedBy            String?                    @db.Uuid
  deletedAt            DateTime?
  deletedBy            String?                    @db.Uuid
  accountProducts      crm_AccountProducts[]
  opportunityLineItems crm_OpportunityLineItems[]
  category             crm_ProductCategories?     @relation(fields: [categoryId], references: [id])
  created_by_user      Users                      @relation("ProductCreatedBy", fields: [createdBy], references: [id])

  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@index([createdBy])
  @@index([deletedAt])
}

model crm_AccountProducts {
  id            String                    @id @default(uuid()) @db.Uuid
  accountId     String                    @db.Uuid
  productId     String                    @db.Uuid
  quantity      Int                       @default(1)
  custom_price  Decimal?                  @db.Decimal(18, 2)
  snapshot_rate Decimal?                  @db.Decimal(18, 8)
  status        crm_AccountProduct_Status @default(ACTIVE)
  start_date    DateTime
  end_date      DateTime?
  renewal_date  DateTime?
  notes         String?
  v             Int                       @default(0) @map("__v")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  createdBy     String                    @db.Uuid
  updatedBy     String?                   @db.Uuid
  account       crm_Accounts              @relation(fields: [accountId], references: [id])
  product       crm_Products              @relation(fields: [productId], references: [id])

  @@index([accountId])
  @@index([productId])
  @@index([status])
  @@index([accountId, productId])
}

model crm_OpportunityLineItems {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @db.Uuid
  productId      String?           @db.Uuid
  name           String
  sku            String?
  description    String?
  quantity       Int               @default(1)
  unit_price     Decimal           @db.Decimal(18, 2)
  discount_type  crm_Discount_Type @default(PERCENTAGE)
  discount_value Decimal           @default(0) @db.Decimal(18, 2)
  line_total     Decimal           @db.Decimal(18, 2)
  sort_order     Int               @default(0)
  v              Int               @default(0) @map("__v")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String            @db.Uuid
  updatedBy      String?           @db.Uuid
  product        crm_Products?     @relation(fields: [productId], references: [id])

  @@index([opportunityId])
  @@index([productId])
}

model crm_Appointments {
  id          String            @id @default(uuid()) @db.Uuid
  v           Int               @default(0) @map("__v")
  patientId   String            @db.Uuid
  doctorId    String            @db.Uuid
  staffId     String?           @db.Uuid
  scheduledAt DateTime
  duration    Int
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String            @db.Uuid
  updatedBy   String?           @db.Uuid
  doctor      Users             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient     crm_Contacts      @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  staff       Users?            @relation("StaffAppointments", fields: [staffId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([staffId])
  @@index([scheduledAt])
  @@index([status])
}

